# ---------- 路径 ----------
DATA_DIR=./data
DB_PATH=./data/helpdesk.db
CACHE_DIR=./.cache
REPORTS_DIR=./reports

# ---------- 数据源 ----------
DOCS_REPO=https://github.com/docker/docs.git
# 留空表示用默认分支 HEAD；填了则锁定到该 commit（可复现）
DOCS_COMMIT=
DOCS_MAX_FILES=400
ISSUES_REPOS=docker/for-win,moby/moby

# ---------- GitHub（必填，否则 60 次/小时限流） ----------
GITHUB_TOKEN=

# ---------- 模型 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
BAILIAN_API_KEY=
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 向量库与向量化 ----------
# faiss（默认，零服务依赖） | chroma | milvus
# 注意：Chroma 在本项目实测会在 3,441 行静默丢写，Milvus 镜像拉取失败，详见 docs/deep-dive.md
VECTOR_BACKEND=faiss
# bailian（默认，走 API） | local（需本地 torch + bge-m3）
EMBED_PROVIDER=bailian
# 仅当 VECTOR_BACKEND=milvus 时需要
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=helpdesk_chunks
EMBED_DIM=1024

# ---------- 检索参数 ----------
CHUNK_SIZE=400
CHUNK_OVERLAP=80
RETRIEVE_TOPK=50
RERANK_TOPK=20
FINAL_TOPK=5
# RRF 融合常数：实测 k=20~60 无差异，k=100 变差
RRF_K=60
# 双语 BM25（英文改写查官方文档 + 原始中文查工单案例）
BM25_BILINGUAL=true
# 文档黑名单（release-notes 类"万能吸铁石"）：实测贡献 +8.4pp
EXCLUDE_PATHS=manuals/desktop/release-notes,manuals/desktop/previous-versions,manuals/engine/release-notes

# ---------- 长期记忆 ----------
MEMORY_BACKEND=redis
REDIS_HOST=127.0.0.1
# 注意：Docker 映射端口常见为 26379，不是 6379
REDIS_PORT=26379
REDIS_DB=1
MEMORY_FALLBACK_SQLITE=true

# ---------- 网页搜索兜底 ----------
WEB_FALLBACK=true
WEB_TOPK=5
TAVILY_API_KEY=
