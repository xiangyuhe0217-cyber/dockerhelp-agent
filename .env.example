# ---------- 路径 ----------
DATA_DIR=./data
DB_PATH=./data/helpdesk.db
CACHE_DIR=./.cache
REPORTS_DIR=./reports

# ---------- 数据源 ----------
DOCS_REPO=https://github.com/docker/docs.git
# 留空表示用默认分支 HEAD；填了则锁定到该 commit（可复现）
DOCS_COMMIT=
DOCS_MAX_FILES=400
ISSUES_REPOS=docker/for-win,moby/moby

# ---------- GitHub（必填，否则 60 次/小时限流） ----------
GITHUB_TOKEN=

# ---------- 模型 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
BAILIAN_API_KEY=
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- Milvus（W2 起使用） ----------
# 本地 Standalone：http://127.0.0.1:19530
# Zilliz Cloud：填 https://xxx.zillizcloud.com 并把 token 一起配上
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=helpdesk_chunks
EMBED_DIM=1024

# ---------- 检索参数 ----------
CHUNK_SIZE=400
CHUNK_OVERLAP=80
RETRIEVE_TOPK=50
RERANK_TOPK=20
FINAL_TOPK=5
